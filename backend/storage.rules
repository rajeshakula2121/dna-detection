rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // User folder: only the authenticated owner can read/write their files
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 20 * 1024 * 1024; // 20MB limit
    }
    
    // Shared benchmark reference datasets (read-only for authenticated users)
    match /public_references/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
