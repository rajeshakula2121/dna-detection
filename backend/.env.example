# BioDNA Application Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Sequence Engine Limits
MAX_SEQUENCE_LENGTH=50000
MAX_ALIGNMENT_LENGTH=10000

# Firebase Admin Configuration (Optional for production verification)
FIREBASE_PROJECT_ID=dna-detection
